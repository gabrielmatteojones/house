# Copia in .env per provare in locale (npx netlify dev). Su Netlify vanno nelle variabili d'ambiente, ambito Functions.
PORTAL_USER=
PORTAL_PASSWORD=

# Posta (Zoho)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=incolla-qui-il-client-secret
ZOHO_DC=eu

# Facoltative
# PRESENZE_TOKEN=          token del file offline «Presenze in rete»
# VAPID_PUBLIC_KEY=        notifiche push: se mancano si creano da sole
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
